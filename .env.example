NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Use mongodb://mongo:27017 when running inside Docker Compose.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fastify_showcase
MONGODB_POOL_SIZE=10

# Replace with a secure secret (at least 32 characters): openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-generated-secret
